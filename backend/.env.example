# CareerPath AI - Backend Environment Configuration

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or local connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/careerpath_ai?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/careerpath_ai
MONGODB_URI=mongodb://127.0.0.1:27017/careerpath_ai

# JWT secret for authentication signing
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string

# Google Gemini API Key for LangGraph workflows
GOOGLE_API_KEY=your_google_gemini_api_key

# ImageKit Configuration for PDF uploads (Resume & Job Descriptions)
# Sign up at https://imagekit.io (Free tier available)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
